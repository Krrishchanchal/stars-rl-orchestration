# Local credentials
.env
.env.*
!.env.example

# Generated large artifacts
data/generated/
checkpoints/
runs/
artifacts/

# Source PDFs are not redistributed with this project
*.pdf

# Reviewed scientific specifications and traceability are tracked explicitly.
# Evidence, raw transcripts, personal progress notes and other docs stay local.
/docs/*
!/docs/model_specification.md
!/docs/decisions.md
!/docs/execution_contract.md
!/docs/experiment_contract.md
!/docs/implementation_plan.md
!/docs/commit_roadmap.md
!/docs/test_plan.md
!/docs/test_matrix.csv
!/docs/oracle_catalog.md
!/docs/reproducibility.md
!/docs/review_summary.md
!/docs/physical_family_proposal.md
!/docs/USAGE.md
/CONTEXT.md

# Keep complete legacy snapshots and machine transcripts locally.
# Compact final experiment inputs, raw gzip records, summaries and figures are tracked.
/experiments/archive/
/experiments/*.log
/experiments/results/**/physical/*-prefix.log
